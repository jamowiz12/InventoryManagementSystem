{
  "info": {
    "_postman_id": "27466a30-495c-4c44-82be-202611060001",
    "name": "Inventory Management System API",
    "description": "Laravel 12 API backed by Supabase PostgreSQL routines. Set baseUrl, categoryId, supplierId, and productId after database setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api" },
    { "key": "categoryId", "value": "1" },
    { "key": "supplierId", "value": "1" },
    { "key": "productId", "value": "1" },
    { "key": "missingProductId", "value": "999999999" }
  ],
  "item": [
    { "name": "Get all products", "request": { "method": "GET", "url": "{{baseUrl}}/products" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Returns products successfully', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().success).to.eql(true); });"] } }] },
    { "name": "Get a specific product", "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Returns selected product', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.id).to.eql(Number(pm.variables.get('productId'))); });"] } }] },
    { "name": "Add a product", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"category_id\": {{categoryId}},\n  \"supplier_id\": {{supplierId}},\n  \"product_name\": \"Postman Test Product\",\n  \"description\": \"Created from Postman\",\n  \"unit_price\": 4.50,\n  \"stock_quantity\": 20,\n  \"minimum_stock\": 5\n}" }, "url": "{{baseUrl}}/products" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Product is created', function () { pm.response.to.have.status(201); pm.expect(pm.response.json().success).to.eql(true); pm.environment.set('productId', pm.response.json().data.id); });"] } }] },
    { "name": "Get stock value (SQL function)", "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}/stock-value" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('SQL function returns stock value', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.stock_value).to.exist; });"] } }] },
    { "name": "Get stock status (SQL function)", "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}/stock-status" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('SQL function returns a valid status', function () { pm.response.to.have.status(200); pm.expect(['OUT OF STOCK', 'LOW STOCK', 'AVAILABLE']).to.include(pm.response.json().data.stock_status); });"] } }] },
    { "name": "Stock in (stored procedure)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"product_id\": {{productId}},\n  \"quantity\": 5,\n  \"remarks\": \"Postman stock-in test\"\n}" }, "url": "{{baseUrl}}/stock-in" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Stock-in succeeds', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().success).to.eql(true); });"] } }] },
    { "name": "Stock out (stored procedure)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"product_id\": {{productId}},\n  \"quantity\": 2,\n  \"remarks\": \"Postman stock-out test\"\n}" }, "url": "{{baseUrl}}/stock-out" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Stock-out succeeds', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().success).to.eql(true); });"] } }] },
    { "name": "Get stock transactions", "request": { "method": "GET", "url": "{{baseUrl}}/transactions" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Transactions are returned', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().success).to.eql(true); });"] } }] },
    { "name": "Get categories", "request": { "method": "GET", "url": "{{baseUrl}}/categories" } },
    { "name": "Get suppliers", "request": { "method": "GET", "url": "{{baseUrl}}/suppliers" } },
    { "name": "NEGATIVE - Stock out exceeds available inventory", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"product_id\": {{productId}},\n  \"quantity\": 100,\n  \"remarks\": \"Expected insufficient stock rejection\"\n}" }, "url": "{{baseUrl}}/stock-out" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Insufficient stock is rejected', function () { pm.expect(pm.response.code).to.be.oneOf([422]); pm.expect(pm.response.json().message).to.include('Insufficient stock'); });"] } }] },
    { "name": "NEGATIVE - Stock-in quantity is zero", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"product_id\": {{productId}},\n  \"quantity\": 0\n}" }, "url": "{{baseUrl}}/stock-in" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Zero quantity is rejected', function () { pm.response.to.have.status(422); });"] } }] },
    { "name": "NEGATIVE - Product ID does not exist", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"product_id\": {{missingProductId}},\n  \"quantity\": 1\n}" }, "url": "{{baseUrl}}/stock-out" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unknown product is rejected', function () { pm.response.to.have.status(422); });"] } }] },
    { "name": "NEGATIVE - Product price is negative", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"category_id\": {{categoryId}},\n  \"supplier_id\": {{supplierId}},\n  \"product_name\": \"Invalid Negative Price\",\n  \"unit_price\": -1,\n  \"stock_quantity\": 1,\n  \"minimum_stock\": 0\n}" }, "url": "{{baseUrl}}/products" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Negative price is rejected', function () { pm.response.to.have.status(422); });"] } }] },
    { "name": "NEGATIVE - Product stock is negative", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"category_id\": {{categoryId}},\n  \"supplier_id\": {{supplierId}},\n  \"product_name\": \"Invalid Negative Stock\",\n  \"unit_price\": 1,\n  \"stock_quantity\": -1,\n  \"minimum_stock\": 0\n}" }, "url": "{{baseUrl}}/products" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Negative stock is rejected', function () { pm.response.to.have.status(422); });"] } }] }
  ]
}